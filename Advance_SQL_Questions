-- 1. For every customer, calculate a running count of orders sorted by order_date.

select c.customer_id, c.first_name, c.last_name, o.order_id,o.order_date,
COUNT(o.order_id) OVER ( partition by c.customer_id order by o.order_date) as Count_of_order_for_each_customer,
COUNT(o.order_id) OVER (order by o.order_date) as Running_order
from customers c 
left join orders o 
on o.customer_id = c.customer_id;

-- 2. Show each order’s total_amount and the median (50th-percentile) order value for that customer.
WITH numbered AS (
SELECT total_amount,
ROW_NUMBER() OVER (order by total_amount) as rn,
COUNT(*) OVER() as cnt
from orders 
)
select AVG(total_amount) AS median_count
From Numbered
where rn in (Floor((cnt+1)/2),
CEIL((cnt+1)/2)
);

-- 3. List the five most recent orders per customer.
Select o.order_id, o.customer_id, o.order_date,
c.first_name,
RANK() OVER (PARTITION BY o.customer_id Order by o.order_date ROWS BETWEEN CURRENT ROW AND unbounded following) as Top5_recent_orders
from orders o 
left join customers c
on o.customer_id = c.customer_id;

